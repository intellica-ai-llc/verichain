{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/intellica-ai-llc/verichain/spec/statement.schema.json",
  "title": "VeriChain Decision Primitive v2 (payload of the COSE_Sign1 statement)",
  "type": "object",
  "required": ["v", "kind", "agent", "seq", "prev", "ts"],
  "properties": {
    "v": {"const": 2},
    "kind": {"enum": ["intent", "outcome", "policy", "delegation", "artifact", "attestation", "lifecycle", "approval", "settlement", "governance"]},
    "agent": {"type": "object", "required": ["id"], "properties": {
      "id": {"type": "string", "minLength": 1},
      "runtime": {"type": "object", "properties": {"kind": {"enum": ["asl", "gateway", "signer", "sdk"]}, "version": {"type": "string"}}}}},
    "seq": {"type": "integer", "minimum": 0},
    "prev": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "hex SHA-256 of the previous statement's RFC 8785 bytes; 64 zeros for seq 0"},
    "ts": {"type": "string", "format": "date-time"},
    "principal": {"type": "object", "properties": {
      "delegator": {"type": "string"}, "capability_chain": {"type": "array", "items": {"type": "string"}}, "policy_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "action": {"type": "object", "properties": {"type": {"type": "string"}, "target": {"type": "string"}, "params_commitment": {"type": "string"}}},
    "pair": {"type": "object", "required": ["intent_id"], "properties": {"intent_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "verdict": {"type": "object", "properties": {"decision": {"enum": ["allow", "deny", "escalate"]}, "reasons": {"type": "array", "items": {"type": "string"}}}},
    "io": {"type": "object"},
    "completeness": {"enum": ["C0", "C1", "C2", "C3"]},
    "assurance": {"type": "array", "items": {"enum": ["A0", "A1", "A2", "A3"]}},
    "ext": {"type": "object"}
  },
  "allOf": [{"if": {"properties": {"kind": {"const": "outcome"}}}, "then": {"required": ["pair"]}}]
}
